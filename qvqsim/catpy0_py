#!/usr/bin/env python3

import os

folder_path = "."  # Replace with the actual folder path
script_name = "catpy.py"  # This file's name

output_text = "# Begin: several files for chatbot"

for filename in os.listdir(folder_path):
    if filename.endswith(".py"):
        file_path = os.path.join(folder_path, filename)
        with open(file_path, "r", encoding="utf-8") as file:
            output_text += file.read() + f"\n# {filename} ends\n\n"

output_text += "# End: several files for chatbot"
print(output_text)  # Or save to a file if needed
